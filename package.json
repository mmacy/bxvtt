{
  "name": "bxvtt",
  "private": true,
  "version": "0.5.0",
  "description": "A web-based virtual tabletop for B/X games, built on bxapi.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @bxvtt/server\" \"npm run dev -w @bxvtt/web\"",
    "dev:bxapi": "scripts/dev-bxapi.sh",
    "build": "npm run build -w @bxvtt/web && npm run build -w @bxvtt/server",
    "start": "npm run start -w @bxvtt/server",
    "share": "node apps/server/scripts/share.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "gen:bxapi": "node scripts/gen-bxapi-types.mjs",
    "test:e2e": "playwright test",
    "test:e2e:prod": "npm run build && E2E_PROD=1 playwright test",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "cloudflared": "^0.7.3",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
