{
  "name": "@bxvtt/server",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "BXAPI_URL=${BXAPI_URL:-http://127.0.0.1:8651} tsx watch --disable-warning=ExperimentalWarning src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --packages=external --alias:@bxvtt/shared=../../packages/shared/src --outfile=dist/main.js",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  }
}
