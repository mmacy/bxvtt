      "journal": [
        {
          "text": "The ferry grounds at the landing stage of Corvane's Holm. As you step ashore, a bell tolls once, somewhere beneath your feet.",
          "rounds": 180
        },
        {
          "text": "As the ferry grounds, the ferryman tells you about the priory's relic, the Hand of Saint Corvane, lost in the flood. The temple would pay well to have it back.",
          "rounds": 180
        }
      ],
      "quests": [
        {
          "id": "red_thumbs",
          "name": "Break the Red Thumbs",
          "narrative": "Reeve Tamsin Hale has posted a bounty on the ferry house door: 100 gp for the death of Gashnak One-Ear, the hobgoblin whose goblins rob the ferry and the eel traps.",
          "speaker": "Reeve Tamsin Hale",
          "objectives": [
            {
              "id": "kill_gashnak",
              "name": "Kill Gashnak One-Ear",
              "state": "incomplete"
            },
            {
              "id": "report_to_reeve",
              "name": "Report to Reeve Tamsin Hale",
              "state": "incomplete"
            }
          ]
        },
        {
          "id": "saints_hand",
          "name": "The Hand of Saint Corvane",
          "narrative": "As the ferry grounds, the ferryman tells you about the priory's relic, the Hand of Saint Corvane, lost in the flood. The temple would pay well to have it back.",
          "speaker": "the ferryman",
          "objectives": [
            {
              "id": "find_hand",
              "name": "Recover the Hand",
              "state": "incomplete"
            },
            {
              "id": "return_hand",
              "name": "Return the Hand to the temple",
              "state": "incomplete"
            }
          ]
        },
        {
          "id": "silence_the_bell",
          "name": "Silence the drowned bell",
          "narrative": "Mother Aldis asks you to cross to the priory on Corvane's Holm, find the bell that tolls under the water, and bring back its tongue so the temple can melt it down.",
          "speaker": "Mother Aldis",
          "objectives": [
            {
